DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_SETTINGS_MODULE=config.settings.development

# Database
DATABASE_NAME=loan_lead_management
DATABASE_USER=loan_app_user
DATABASE_PASSWORD=replace-with-a-strong-password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# Credit Score provider: crif | mock
CREDIT_SCORE_PROVIDER=mock
CRIF_API_BASE_URL=https://sandbox.crif.example.com
CRIF_API_KEY=
CRIF_API_TIMEOUT_SECONDS=8

CORS_ALLOWED_ORIGINS=http://localhost:3000
